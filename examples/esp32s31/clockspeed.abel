# Clockspeed: the same work at each clock of the core, and the time it takes. cpu_clock (include "cpuclock.abel")
# sets the clock of the ESP32-S31: 320, 160, 80 or 53 MHz from its PLL, 40, 20, 10, 8, 5, 4, 2 or 1 MHz from the
# crystal (less current; not while the WiFi runs: then cpu_clock gives -1, and "wlan off" in the console switches it
# off); 0 only asks. millis() and the terminal go on right at each clock, down to 1 MHz: the USB port of the S31 does not run
# from the clock of the core. At the end the program sets the clock it found again (the console keeps the clock a
# program leaves). Start it with F9, or upload it and type "clockspeed" in the console.

target "esp32s31"

include "console.abel"
include "cpuclock.abel"

# the same work at each clock: a loop of shifts and xor
def work() i32:
    s = 0
    for i in 0..100000:
        s += i ^ (s >> 3)
    return s

# the core at mhz, then the work and its time
def run_at(mhz):
    got = cpu_clock(mhz)
    print("  ")
    print_int(mhz)
    print(" MHz: ")
    if got < 0:
        println("not possible now")
        return
    start = millis()
    work()
    print_int(millis() - start)
    println(" ms")

def main():
    start = cpu_clock(0)
    print("clockspeed: the console runs the core at ")
    print_int(start)
    println(" MHz")
    run_at(320)
    run_at(160)
    run_at(80)
    run_at(53)
    run_at(40)
    run_at(20)
    run_at(10)
    run_at(5)
    run_at(2)
    run_at(1)
    println("(the crystal clocks need the WiFi off)")
    cpu_clock(start)
