# BME280 with light sleep: the readings of bme280.abel (temperature, air pressure, humidity of a Bosch BME280 at I2C),
# but between them the ESP32 sleeps instead of waiting in a loop. Every ten seconds the chip wakes up, the sensor
# measures once, the line goes out, and the chip sleeps again; it is awake only a few milliseconds of the ten seconds.
# A key in the terminal (also Ctrl+C, or Stop in Asmonite) wakes it and ends the program. "bme280_sleep 5" reads five
# times and ends.
#
# Wiring as in bme280.abel: SDA at GPIO 21, SCL at GPIO 22, VCC at 3.3 V, GND at GND; the sensor at 0x76 or 0x77.
#
# Light sleep (ESP32 Technical Reference Manual, chapter "Low-Power Management"; ESP-IDF rtc_sleep.c): the clocks of
# the cores and of the peripherals stop, the RAM keeps its contents, and the program goes on behind the point where it
# fell asleep. The chip itself then needs about 0.8 mA instead of some 30 to 50 mA (the datasheet; the regulator and
# the LED of a DevKit board need more than that). Who wakes it: the timer of the RTC part (it runs on in the sleep, on
# a slow clock of its own) and a low level at GPIO 3, the RX line of UART0 (a key from the terminal).
#   RTC_CNTL (0x3FF48000): SLP_TIMER0/1 the time of the alarm (+ bit 16 of SLP_TIMER1: the alarm on), TIME_UPDATE and
#   TIME0/1 the time now, WAKEUP_STATE bits 21..11 who may wake it (bit 3 of them the timer, bit 2 the GPIOs) and
#   bits 10..0 who did, STATE0 bit 31 SLEEP_EN: go to sleep, INT_RAW bit 0: awake again (bit 1: the sleep was rejected).
# millis() of the console counts the cycles of the core: in the sleep it stands still. So the program takes its time
# from the RTC (and shows how long the core was awake by millis()).
#
# The WiFi of the console runs on core 1: it does not survive a light sleep. When it runs, the program switches it
# off first (wifi_halt of the WiFi service, as wlan off in the console does); "wlan on" in the console switches it on
# again.

target "esp32"
include "console.abel"

SDA = 21                        # the pins of the bus
SCL = 22
I2C_DELAY = 20                  # rounds of a loop for half a clock of the bus (about 100 kHz)
EVERY_MS = 10000                # one reading every 10 seconds

GPIO_ENABLE_W1TS = 0x24 / 4     # registers of the GPIO (con_gpio of console.abel counts in words)
GPIO_ENABLE_W1TC = 0x28 / 4
GPIO_OUT_W1TC = 0x0C / 4
GPIO_IN = 0x3C / 4
GPIO_STATUS_W1TC = 0x4C / 4     # a 1 clears the interrupt status of a pin
GPIO_PIN3 = (0x88 + 4 * 3) / 4  # GPIO_PIN3_REG: bits 9..7 INT_TYPE (4: low level), bit 10 WAKEUP_ENABLE
RX_PIN = 3                      # the RX line of UART0: the keys of the terminal

rtc: u32[64] at 0x3FF48000      # RTC_CNTL
uart0: u32[32] at 0x3FF40000    # UART0
dport: u32[64] at 0x3FF00000    # DPORT

SLP_TIMER0 = 0x04 / 4
SLP_TIMER1 = 0x08 / 4
TIME_UPDATE = 0x0C / 4
TIME0 = 0x10 / 4
TIME1 = 0x14 / 4
STATE0 = 0x18 / 4
WAKEUP_STATE = 0x38 / 4
INT_RAW = 0x40 / 4
INT_CLR = 0x48 / 4

# the WiFi service (wlan/wlansvc.asm): its mark "WSVC", its version, wifi_halt
def wsvc_halt() i32 at 0x40094050
svc: u32[32] at 0x40094000

BME280 = 0x60                   # the chip id in register 0xD0
BMP280 = 0x58

buf: char[32]                   # the bytes read from the sensor
dev: i32 = 0                    # its address on the bus (0x76 or 0x77)
chip: i32 = 0                   # its chip id
rtc_hi: u32 = 0                 # bits 47..32 of the RTC time (rtc_now)
rtc_hz: i32 = 0                 # the slow clock of the RTC, measured at the start

# the calibration of the sensor (written into it at the factory), named as in the datasheet: dig_T1 is t1 here
t1: i32 = 0
t2: i32 = 0
t3: i32 = 0
p1: i32 = 0
p2: i32 = 0
p3: i32 = 0
p4: i32 = 0
p5: i32 = 0
p6: i32 = 0
p7: i32 = 0
p8: i32 = 0
p9: i32 = 0
h1: i32 = 0
h2: i32 = 0
h3: i32 = 0
h4: i32 = 0
h5: i32 = 0
h6: i32 = 0
t_fine: i32 = 0                 # the temperature as the formulas of pressure and humidity need it

# n milliseconds, awake
def wait_ms(n):
    t = millis()
    while millis() - t < n:
        pass

# ---------- the sleep ----------

# the time of the RTC in ticks of its slow clock: bits 31..0 (bits 47..32 into rtc_hi)
def rtc_now() u32:
    rtc[TIME_UPDATE] = 0x80000000                   # TIME_UPDATE: copy the time into TIME0/1
    n = 0
    while (rtc[TIME_UPDATE] & 0x40000000) == 0 and n < 100000:     # TIME_VALID
        n += 1
    rtc_hi = rtc[TIME1] & 0xFFFF
    return rtc[TIME0]

# ticks of the RTC in milliseconds
def ticks_ms(ticks: u32) i32:
    return i32(ticks / u32(rtc_hz / 1000))

# milliseconds in ticks of the RTC
def ms_ticks(ms) u32:
    return u32((ms / 1000) * rtc_hz + (ms % 1000) * rtc_hz / 1000)

# the slow clock of the RTC in Hz (about 150 kHz, and not exact): its ticks in half a second of millis()
def measure_rtc_clock():
    r0 = rtc_now()
    m0 = millis()
    wait_ms(500)
    r1 = rtc_now()
    rtc_hz = i32(r1 - r0) * 1000 / (millis() - m0)

# the text sent before the sleep (in the sleep the UART stops): the FIFO empty, then the last byte out
def uart_drain():
    while ((uart0[0x1C / 4] >> 16) & 0xFF) != 0:
        pass
    wait_ms(2)

# light sleep for ms milliseconds, or until a key (key 1): 1 the timer woke it, 2 a key, 0 the chip did not sleep
def light_sleep(ms, key) i32:
    lo = rtc_now()
    hi = rtc_hi
    alarm = lo + ms_ticks(ms)
    if alarm < lo:
        hi += 1
    rtc[SLP_TIMER0] = alarm
    rtc[SLP_TIMER1] = (hi & 0xFFFF) | 0x10000       # bit 16: the alarm on
    wake = 8                                        # the timer
    if key:
        con_gpio[GPIO_PIN3] = (con_gpio[GPIO_PIN3] & ~u32(0x780)) | 0x600      # low level at RX wakes it
        wake = 8 | 4                                # ... and the GPIOs
    rtc[WAKEUP_STATE] = (rtc[WAKEUP_STATE] & ~u32(0x7FF << 11)) | u32(wake << 11)
    rtc[INT_CLR] = 3
    rtc[STATE0] = rtc[STATE0] | 0x80000000          # SLEEP_EN: now
    while (rtc[INT_RAW] & 3) == 0:                  # here the chip sleeps, and goes on when it wakes
        pass
    raw = rtc[INT_RAW] & 3
    rtc[INT_CLR] = 3
    rtc[SLP_TIMER1] = 0                             # the alarm off
    cause = rtc[WAKEUP_STATE] & 0x7FF
    if key:
        con_gpio[GPIO_PIN3] = con_gpio[GPIO_PIN3] & ~u32(0x780)
        con_gpio[GPIO_STATUS_W1TC] = u32(1 << RX_PIN)
    if (raw & 1) == 0:
        return 0
    if cause & 4:
        return 2
    return 1

# the WiFi service runs on core 1 (core 1 has its clock, the service its mark "WSVC")
def wifi_runs() i32:
    return (dport[0x30 / 4] & 1) == 1 and svc[0x1C / 4] == 0x43565357

# ---------- I2C by hand (as in bme280.abel) ----------

# half a clock of the bus
def pause():
    for i in 0..I2C_DELAY:
        pass

# a pin for the bus: GPIO, its input on, its pull-up on, its output level 0 but its output off (the line high)
def i2c_pin(pin):
    con_iomux[con_mux_off(pin) / 4] = 0x2B00        # MCU_SEL 2: GPIO, FUN_DRV 2, FUN_IE, FUN_WPU
    con_gpio[0x530 / 4 + pin] = 0x100               # FUNCn_OUT_SEL: the level of GPIO_OUT
    con_gpio[GPIO_OUT_W1TC] = u32(1 << pin)
    con_gpio[GPIO_ENABLE_W1TC] = u32(1 << pin)

# the line low (the output on)
def line_low(pin):
    con_gpio[GPIO_ENABLE_W1TS] = u32(1 << pin)

# the line let go: the pull-up makes it high, unless a device pulls it low
def line_free(pin):
    con_gpio[GPIO_ENABLE_W1TC] = u32(1 << pin)

# the level of the line: 1 or 0
def line_level(pin) i32:
    return i32(con_gpio[GPIO_IN] >> u32(pin)) & 1

# SCL high; a device may hold it low a while longer ("clock stretching"): wait for it
def scl_high():
    line_free(SCL)
    n = 0
    while line_level(SCL) == 0 and n < 1000:
        n += 1
    pause()

# start: SDA goes low while SCL is high (also a repeated start in the middle of a transfer)
def i2c_start():
    line_free(SDA)
    pause()
    scl_high()
    line_low(SDA)
    pause()
    line_low(SCL)
    pause()

# stop: SDA goes high while SCL is high
def i2c_stop():
    line_low(SDA)
    pause()
    scl_high()
    line_free(SDA)
    pause()

# a byte to the bus, the highest bit first: 1 when the device answered with ACK (it pulled SDA low)
def i2c_write(b) i32:
    for i in 0..8:
        if (b >> (7 - i)) & 1:
            line_free(SDA)
        else:
            line_low(SDA)
        pause()
        scl_high()
        line_low(SCL)
    line_free(SDA)
    pause()
    scl_high()
    ack = line_level(SDA) == 0
    line_low(SCL)
    pause()
    return ack

# a byte from the bus; more 1: ACK (more bytes are wanted), 0: NACK (the last one)
def i2c_read(more) i32:
    line_free(SDA)
    b = 0
    for i in 0..8:
        pause()
        scl_high()
        b = (b << 1) | line_level(SDA)
        line_low(SCL)
    if more:
        line_low(SDA)
    pause()
    scl_high()
    line_low(SCL)
    line_free(SDA)
    pause()
    return b

# the pins for the bus; nine clocks first, in case a device still holds SDA low; then a stop
def i2c_init():
    i2c_pin(SDA)
    i2c_pin(SCL)
    pause()
    for i in 0..9:
        line_low(SCL)
        pause()
        scl_high()
    line_low(SCL)
    pause()
    i2c_stop()

# ---------- the registers of the sensor (as in bme280.abel) ----------

# n bytes from the register reg on into buf: 1 done, 0 the sensor did not answer
def bme_read(reg, n) i32:
    i2c_start()
    ok = i2c_write(dev << 1)
    if ok:
        ok = i2c_write(reg)
    if ok:
        i2c_start()
        ok = i2c_write((dev << 1) | 1)
    if ok:
        for i in 0..n:
            buf[i] = i2c_read(i < n - 1)
    i2c_stop()
    return ok

# the value v into the register reg: 1 done, 0 the sensor did not answer
def bme_write(reg, v) i32:
    i2c_start()
    ok = i2c_write(dev << 1)
    if ok:
        ok = i2c_write(reg)
    if ok:
        ok = i2c_write(v)
    i2c_stop()
    return ok

# the two bytes at buf[i] (the low one first) as a number 0 .. 65535
def le16(i) i32:
    return buf[i] | (buf[i + 1] << 8)

# ... as a number with a sign, -32768 .. 32767
def le16s(i) i32:
    v = le16(i)
    if v >= 32768:
        v -= 65536
    return v

# a byte 0 .. 255 as a number with a sign, -128 .. 127
def s8(v) i32:
    if v >= 128:
        v -= 256
    return v

# the sensor at 0x76 or 0x77: 1 found (dev, chip), 0 none answered
def find_sensor() i32:
    for a in 0x76..0x78:
        dev = a
        if bme_read(0xD0, 1):
            chip = buf[0]
            return 1
    return 0

# the calibration out of the sensor: 1 done, 0 it did not answer
def read_calibration() i32:
    if not bme_read(0x88, 26):
        return 0
    t1 = le16(0)
    t2 = le16s(2)
    t3 = le16s(4)
    p1 = le16(6)
    p2 = le16s(8)
    p3 = le16s(10)
    p4 = le16s(12)
    p5 = le16s(14)
    p6 = le16s(16)
    p7 = le16s(18)
    p8 = le16s(20)
    p9 = le16s(22)
    h1 = buf[25]
    if chip == BME280:
        if not bme_read(0xE1, 7):
            return 0
        h2 = le16s(0)
        h3 = buf[2]
        h4 = (s8(buf[3]) << 4) | (buf[4] & 15)      # 12 bits with a sign, spread over 0xE4 and 0xE5
        h5 = (s8(buf[5]) << 4) | (buf[4] >> 4)      # ... over 0xE5 and 0xE6
        h6 = s8(buf[6])
    return 1

# ---------- the formulas of the datasheet (as in bme280.abel) ----------

# the temperature in 1/100 degree Celsius (2147: 21.47 C); sets t_fine
def temperature(adc) i32:
    v1 = (((adc >> 3) - (t1 << 1)) * t2) >> 11
    d = (adc >> 4) - t1
    v2 = (((d * d) >> 12) * t3) >> 14
    t_fine = v1 + v2
    return (t_fine * 5 + 128) >> 8

# the pressure in pascal (101325: 1013.25 hPa); needs t_fine
def pressure(adc) i32:
    v1 = (t_fine >> 1) - 64000
    v2 = (((v1 >> 2) * (v1 >> 2)) >> 11) * p6
    v2 = v2 + ((v1 * p5) << 1)
    v2 = (v2 >> 2) + (p4 << 16)
    v1 = (((p3 * (((v1 >> 2) * (v1 >> 2)) >> 13)) >> 3) + ((p2 * v1) >> 1)) >> 18
    v1 = ((32768 + v1) * p1) >> 15
    if v1 == 0:
        return 0                                    # no division by 0
    p = u32(1048576 - adc - (v2 >> 12)) * 3125
    if p < 0x80000000:
        p = (p << 1) / u32(v1)
    else:
        p = (p / u32(v1)) * 2
    v1 = (p9 * i32(((p >> 3) * (p >> 3)) >> 13)) >> 12
    v2 = (i32(p >> 2) * p8) >> 13
    return i32(p) + ((v1 + v2 + p7) >> 4)

# the humidity in 1/1024 percent (46080: 45.00 %); needs t_fine
def humidity(adc) i32:
    v = t_fine - 76800
    a = (((adc << 14) - (h4 << 20) - (h5 * v)) + 16384) >> 15
    b = (((((((v * h6) >> 10) * (((v * h3) >> 11) + 32768)) >> 10) + 2097152) * h2 + 8192) >> 14)
    v = a * b
    v = v - (((((v >> 15) * (v >> 15)) >> 7) * h1) >> 4)
    if v < 0:
        v = 0
    if v > 419430400:
        v = 419430400
    return v >> 12

# ---------- output ----------

# v / 100 with two places: 2147 is "21.47", -5 is "-0.05"
def print_hundredths(v):
    if v < 0:
        put_char('-')
        v = 0 - v
    print_int(v / 100)
    put_char('.')
    put_char('0' + v / 10 % 10)
    put_char('0' + v % 10)

# the number at the start of t (its digits), 0 if there are none
def number(t: pchar) i32:
    n = 0
    i = 0
    while t[i] >= '0' and t[i] <= '9':
        n = n * 10 + (t[i] - '0')
        i += 1
    return n

# one reading: the sensor measures once ("forced mode"; then it sleeps itself), then its values: 1 done, 0 no answer
def measure() i32:
    if chip == BME280:
        bme_write(0xF2, 1)                          # ctrl_hum: humidity once (before ctrl_meas, which takes it)
    if not bme_write(0xF4, 0x25):                   # ctrl_meas: temperature once, pressure once, forced mode
        return 0
    wait_ms(2)
    t = millis()
    while millis() - t < 100:                       # status: bit 3 is 1 while it measures (about 10 ms)
        if bme_read(0xF3, 1) and (buf[0] & 8) == 0:
            break
    if not bme_read(0xF7, 8):                       # the raw values: pressure 20 bits, temperature 20, humidity 16
        return 0
    adc_p = (buf[0] << 12) | (buf[1] << 4) | (buf[2] >> 4)
    adc_t = (buf[3] << 12) | (buf[4] << 4) | (buf[5] >> 4)
    adc_h = (buf[6] << 8) | buf[7]
    print("temperature ")
    print_hundredths(temperature(adc_t))
    print(" C   pressure ")
    print_hundredths(pressure(adc_p))
    print(" hPa")
    if chip == BME280:
        print("   humidity ")
        print_hundredths(humidity(adc_h) * 100 / 1024)
        print(" %")
    return 1

def main():
    count = number(args())                          # 0: until a key
    println("bme280_sleep: a reading every 10 s, light sleep in between (a key ends it)")
    if wifi_runs():
        if svc[32 / 4] >= 8:
            wsvc_halt()
            println("The WiFi ran on core 1; it does not survive a light sleep: off now (wlan on in the console).")
        else:
            println("The WiFi runs on core 1 and its service is too old to stop: type wlan off in the console first.")
            return
    i2c_init()
    if line_level(SDA) == 0 or line_level(SCL) == 0:
        println("A line of the bus stays low: no pull-up, or SDA/SCL shorted to GND. Check the wiring.")
        return
    if not find_sensor():
        println("No sensor answers at 0x76 or 0x77. Check the wiring: SDA GPIO 21, SCL GPIO 22, 3.3 V, GND.")
        return
    if chip != BME280 and chip != BMP280:
        print("chip id 0x")
        print_byte(chip)
        println(": not a BME280 or BMP280; read like a BMP280 (no humidity)")
    bme_write(0xE0, 0xB6)                           # reset: the sensor starts afresh, as after power on
    wait_ms(5)
    if not read_calibration():
        println("The sensor does not answer any more.")
        return
    measure_rtc_clock()
    print("The slow clock of the RTC: ")
    print_int(rtc_hz)
    println(" Hz")
    key = 1                                         # a key wakes it
    start = rtc_now()
    done = 0
    while True:
        awake = millis()
        print_int(ticks_ms(rtc_now() - start) / 1000)
        print(" s   ")
        if not measure():
            print("the sensor did not answer")
        print("   (awake ")
        print_int(millis() - awake)
        println(" ms)")
        done += 1
        if count > 0 and done >= count:
            break
        if poll_char() >= 0:                        # a key while it was awake
            println("A key: the end.")
            break
        uart_drain()
        woke = light_sleep(EVERY_MS, key)
        if woke == 2:
            n = 0
            while line_level(RX_PIN) == 0 and n < 20:
                wait_ms(1)
                n += 1
            if n >= 20:
                key = 0                             # RX stays low (no terminal at it?): only the timer from now on
                println("RX stays low: from now on only the timer wakes the board.")
            else:
                wait_ms(5)
                while poll_char() >= 0:             # what came of the key
                    pass
                println("A key woke the board: the end.")
                break
        elif woke == 0:
            println("(the chip did not go to sleep)")
