# Clockspeed: the same work at each clock of the core, and the time it takes. cpu_clock (include "cpuclock.abel")
# sets the clock of the ESP32-C3: 80 or 160 MHz from the PLL, 40, 20 or 10 MHz from the crystal (less current; not
# while the WiFi runs: then cpu_clock gives -1, and "wlan off" in the console switches it off); 0 only asks. Not below
# 10 MHz: the USB port of the chip, the console, stops working there. millis() and the terminal go on right at each
# clock. At the end the program sets the clock it found again (the console keeps the clock a program leaves).
# Start it with F9, or upload it and type "clockspeed" in the console.

target "esp32c3"

include "console.abel"
include "cpuclock.abel"

# the same work at each clock: a loop of shifts and xor
def work() i32:
    s = 0
    for i in 0..100000:
        s += i ^ (s >> 3)
    return s

# the core at mhz, then the work and its time
def run_at(mhz):
    got = cpu_clock(mhz)
    print("  ")
    print_int(mhz)
    print(" MHz: ")
    if got < 0:
        println("not possible now")
        return
    start = millis()
    work()
    print_int(millis() - start)
    println(" ms")

def main():
    start = cpu_clock(0)
    print("clockspeed: the console runs the core at ")
    print_int(start)
    println(" MHz")
    run_at(160)
    run_at(80)
    run_at(40)
    run_at(20)
    run_at(10)
    run_at(5)
    println("(5 MHz: not on the C3, its USB port needs 10 MHz at least; the crystal clocks need the WiFi off)")
    cpu_clock(start)
