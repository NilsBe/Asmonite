# The WiFi networks near the board: the program lets the WiFi of the board scan all channels and lists each network
# with its signal (dBm), its channel, how it is protected (open, WPA2, WPA3, ...), its BSSID (the MAC of the access
# point) and its name. The same source for the ESP32, the ESP32-S3, the ESP32-C3, the ESP32-S31, the Pico W and the
# Pico 2 W: it has no line target "...", so Asmonite translates it for the board of Project > aBelle for (the board in
# the tab Serial), and include "wifi.abel" takes the WiFi of that board from abelle\lib. Start it with F9.
#
# The board needs its WiFi: the WiFi package on an ESP32 board, the files of the WiFi chip on a Pico W (Prepare Board
# in the Board Manager writes them; the first wifi_ call starts the WiFi). It needs no network: a scan only listens.
include "console.abel"
include "wifi.abel"

NETS = 30
nets: char[1440]                    # NETS * WIFI_REC

# the protection of a network (WIFI_AUTH), 12 places
def auth_name(a) pchar:
    if a == 0:
        return "  open      "
    if a == 1:
        return "  WEP       "
    if a == 2:
        return "  WPA       "
    if a == 3:
        return "  WPA2      "
    if a == 4:
        return "  WPA/WPA2  "
    if a == 5:
        return "  WPA2-ENT  "
    if a == 6:
        return "  WPA3      "
    if a == 7:
        return "  WPA2/WPA3 "
    return "  other     "

# one network: "  -64 dBm  ch 11  WPA2        02:00:00:12:34:56  my-network"
def show(p: pchar):
    rssi = p[WIFI_RSSI]
    if rssi >= 128:
        rssi -= 256
    print("  ")
    print_int(rssi)
    print(" dBm  ch ")
    if p[WIFI_CHANNEL] < 10:
        put_char(' ')
    print_int(p[WIFI_CHANNEL])
    print(auth_name(p[WIFI_AUTH]))
    put_char(' ')
    print_mac(p + WIFI_BSSID)
    print("  ")
    if p[WIFI_SSID] == 0:
        println("(hidden)")
    else:
        println(p + WIFI_SSID)

# an error of the WiFi: its number and what it means
def show_error(what: pchar, r):
    if r < 0:
        r = 0 - r
    print(what)
    print(": error ")
    print_int(r)
    print(" (")
    print(wifi_error_text(r))
    println(")")

def main():
    println("WiFi scan")
    r = wifi_on()
    if r != 0:
        show_error("wifi_on", r)
        return
    n = wifi_scan(nets, NETS)
    if n < 0:
        show_error("wifi_scan", n)
        return
    for i in 0..n:
        show(nets + i * WIFI_REC)
    print_int(n)
    println(" networks")
    wifi_done()
