# FizzBuzz: 1 to 20, Fizz for multiples of 3, Buzz for multiples of 5, FizzBuzz for both; if, elif, else on one line.
# expect-output: 1 2 Fizz 4 Buzz Fizz 7 8 Fizz Buzz 11 Fizz 13 14 FizzBuzz 16 17 Fizz 19 Buzz

extern "kernel32.dll":
    def GetStdHandle(n) u32
    def WriteFile(h: u32, buf: pchar, n: u32, written: pchar, ov: u32) i32

written: char[4]
digits: char[12]

def print(s: pchar):
    n = 0
    while s[n] != 0: n += 1
    WriteFile(GetStdHandle(-11), s, u32(n), written, 0)

def print_int(n):
    p = digits + 11
    p[0] = 0
    while True:
        p -= 1
        p[0] = '0' + n % 10
        n /= 10
        if n == 0: break
    print(p)

def main() i32:
    for i in 1..21:
        if i > 1: print(" ")
        if i % 15 == 0: print("FizzBuzz")
        elif i % 3 == 0: print("Fizz")
        elif i % 5 == 0: print("Buzz")
        else: print_int(i)
    print("\n")
    return 0
