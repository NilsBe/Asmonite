# Hello, world! in aBelle. F9 in Asmonite translates it and runs it; F8 goes from line to line.
# expect-output: Hello, world!

extern "kernel32.dll":
    def GetStdHandle(n) u32
    def WriteFile(h: u32, buf: pchar, n: u32, written: pchar, ov: u32) i32

written: char[4]           # WriteFile puts the number of bytes written here

def main() i32:
    s = "Hello, world!\n"
    n = 0
    while s[n] != 0: n += 1
    WriteFile(GetStdHandle(-11), s, u32(n), written, 0)     # -11: the console
    return 0
