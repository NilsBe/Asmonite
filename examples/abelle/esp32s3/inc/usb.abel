# Text and numbers over the USB port of the ESP32-S3 (its serial port, "USB Serial Device"), for include
# "inc/usb.abel": the same functions as abelle/examples/esp32/inc/uart.abel of the ESP32 (put_char, print, println,
# print_int, put_hex, print_byte, print_mac, print_ip). The peripheral USB Serial/JTAG at 0x60038000: EP1 (+0) a
# byte into the FIFO to the host (64 bytes), EP1_CONF (+4) bit 1 there is room, writing bit 0 sends what is in the
# FIFO; each line end sends. When no program on the PC has the port open the FIFO stays full: after 10 ms the byte
# is dropped.
# The names of the parameters and local variables here begin with u_: in aBelle a local name may not be the one of a
# global of the program that includes this file (an assignment would change that global).
usb_ep1: u32[2] at 0x60038000
def usb_delay_us(us: u32) at 0x40000600                  # ets_delay_us of the ROM

usb_digits: char[12]

# one byte; waits up to 10 ms for room in the FIFO; a line end sends it
def put_char(u_c):
    for u_i in 0..1000:
        if usb_ep1[1] & 2 != 0:
            usb_ep1[0] = u32(u_c)
            if u_c == 10: usb_ep1[1] = 1
            return
        usb_delay_us(10)

# a text up to its 0
def print(u_s: pchar):
    u_n = 0
    while u_s[u_n] != 0:
        put_char(u_s[u_n])
        u_n += 1

# a text and a line end
def println(u_s: pchar):
    print(u_s)
    print("\r\n")

# a number in decimal
def print_int(u_v):
    if u_v < 0:
        put_char('-')
        u_v = 0 - u_v
    u_p = usb_digits + 11
    u_p[0] = 0
    while True:
        u_p -= 1
        u_p[0] = '0' + i32(u32(u_v) % 10)
        u_v = i32(u32(u_v) / 10)
        if u_v == 0: break
    print(u_p)

# a hex digit (0 .. 15)
def put_hex(u_d):
    if u_d < 10: put_char('0' + u_d)
    else: put_char('A' + u_d - 10)

# a byte as two hex digits
def print_byte(u_b):
    put_hex((u_b >> 4) & 15)
    put_hex(u_b & 15)

# the 6 bytes at u_p as a MAC: "CC:50:E3:95:3E:78"
def print_mac(u_p: pchar):
    for u_i in 0..6:
        if u_i > 0: put_char(':')
        print_byte(u_p[u_i])

# the 4 bytes at u_p as an IPv4 address: "192.168.43.17"
def print_ip(u_p: pchar):
    for u_i in 0..4:
        if u_i > 0: put_char('.')
        print_int(u_p[u_i])
