# Chip info of the ESP32 on the DevKit: the MAC address, the package and the revision from the eFuses, every five
# seconds over UART0 (under the debugger in the tab Serial, else in a terminal on the COM port, 115200 baud).
# F9 in Asmonite runs it in the RAM (gone after a reset); Debug > Write to Flash and Run writes it into the flash
# at 0x1000 first (in place of the firmware that was there): then the board runs it at every start, also without
# the PC.
#
# The eFuses are bits that are burnt once in the factory. Block 0 can be read as words at 0x3FF5A000 (esptool,
# targets/esp32.py: EFUSE_RD_REG_BASE): word 1 holds the low four bytes of the MAC address, word 2 in its bits 15..0
# the high two; word 3 the package in bits 11..9 (and bit 2 as its bit 3) and in bit 15 the revision 1, word 5 in
# bit 20 the revision 2; bit 31 of APB_CTRL_DATE (0x3FF6607C) together with both means the revision 3.
#
# The size of the flash is in no eFuse: the flash chip tells it itself (flash_id, its JEDEC id). The packages 6 and 7
# have 2 MB of PSRAM in the chip; the PSRAM of a WROVER module is a chip of its own next to the ESP32 and shows in
# no eFuse either (the can says it: WROOM none, WROVER 4 or 8 MB).
#
# watchdogs_off(): when the boot ROM starts a program from the flash, it switches the watchdogs on. WITHOUT IT A
# BOARD THAT RUNS THE PROGRAM FROM THE FLASH RESETS AFTER A FEW SECONDS (see blink.abel). In the RAM it does no
# harm.
target "esp32"

uart0: u32[32]    at 0x3FF40000     # UART0
timg0: u32[64]    at 0x3FF5F000     # timer group 0
efuse: u32[8]     at 0x3FF5A000     # the words of eFuse block 0
apb:   u32[32]    at 0x3FF66000     # APB_CTRL
spi1:  u32[64]    at 0x3FF42000     # SPI1: the flash

SPI_CMD = 0x00 / 4                  # bit 18 USR: the command starts; 0 again when it is done
SPI_USER = 0x1C / 4                 # bit 31 COMMAND, bit 28 MISO (read)
SPI_USER2 = 0x24 / 4                # bits 31..28 the bits of the command - 1, bits 15..0 the command
SPI_MISO_DLEN = 0x2C / 4            # the bits to read - 1
SPI_W0 = 0x80 / 4                   # what was read

# the flash ready for SPI1 (the boot ROM does it when it starts from the flash, not in its download mode: under F9)
def spi_attach(spiconfig: i32, legacy: i32) i32 at 0x40062A6C     # esp_rom_spiflash_attach

UART_FIFO = 0x00 / 4                # takes a byte to send
UART_STATUS = 0x1C / 4              # bits 23..16: the bytes in the FIFO

T0CONFIG = 0x00 / 4
T0LO = 0x04 / 4
T0UPDATE = 0x0C / 4

APB_CTRL_DATE = 0x7C / 4

# for watchdogs_off()

timg1:    u32[64]    at 0x3FF60000    # timer group 1
rtc_cntl: u32[64]    at 0x3FF48000    # RTC_CNTL

WDT_KEY = 0x50D83AA1                # unlocks the registers of a watchdog
TIMG_WDTCONFIG0 = 0x48 / 4
TIMG_WDTWPROTECT = 0x64 / 4
RTC_WDTCONFIG0 = 0x8C / 4
RTC_WDTWPROTECT = 0xA4 / 4

digits: char[12]

def watchdogs_off():
    timg0[TIMG_WDTWPROTECT] = WDT_KEY       # unlock
    timg0[TIMG_WDTCONFIG0] = 0              # off
    timg0[TIMG_WDTWPROTECT] = 0             # lock
    timg1[TIMG_WDTWPROTECT] = WDT_KEY
    timg1[TIMG_WDTCONFIG0] = 0
    timg1[TIMG_WDTWPROTECT] = 0
    rtc_cntl[RTC_WDTWPROTECT] = WDT_KEY
    rtc_cntl[RTC_WDTCONFIG0] = 0
    rtc_cntl[RTC_WDTWPROTECT] = 0

# timer 0 on: counts up, each microsecond
def timer_start():
    timg0[T0CONFIG] = u32((1 << 31) | (1 << 30) | (40 << 13))

def micros() u32:
    timg0[T0UPDATE] = 1
    return timg0[T0LO]

def wait_ms(ms):
    start = micros()
    while micros() - start < u32(ms * 1000): pass

def put_char(c):
    while ((uart0[UART_STATUS] >> 16) & 0xFF) >= 120: pass
    uart0[UART_FIFO] = u32(c)

def print(s: pchar):
    n = 0
    while s[n] != 0:
        put_char(s[n])
        n += 1

def print_int(v):
    if v < 0:
        put_char('-')
        v = 0 - v
    p = digits + 11
    p[0] = 0
    while True:
        p -= 1
        p[0] = '0' + i32(u32(v) % 10)
        v = i32(u32(v) / 10)
        if v == 0: break
    print(p)

# a byte as two hex digits
def print_hex2(b):
    h = "0123456789abcdef"
    put_char(h[(b >> 4) & 15])
    put_char(h[b & 15])

# the JEDEC id of the flash: the command 0x9F through SPI1, as esptool flash_id does it. The answer: the maker
# (0xEF Winbond, 0xC8 GigaDevice, 0x20 XMC ...), the type, the size as a power of two (0x16: 4 MB, 0x17: 8 MB).
# SPI_USER and SPI_USER2 as they were afterwards (the boot ROM and the console use SPI1 too).
def flash_id() u32:
    old_user = spi1[SPI_USER]
    old_user2 = spi1[SPI_USER2]
    spi1[SPI_MISO_DLEN] = 24 - 1
    spi1[SPI_USER] = u32((1 << 31) | (1 << 28))
    spi1[SPI_USER2] = u32((7 << 28) | 0x9F)
    spi1[SPI_W0] = 0
    spi1[SPI_CMD] = u32(1 << 18)
    n = 0
    while (spi1[SPI_CMD] & u32(1 << 18)) != 0 and n < 100000: n += 1
    id = spi1[SPI_W0] & 0xFFFFFF
    spi1[SPI_USER] = old_user
    spi1[SPI_USER2] = old_user2
    return id

# the revision of the chip (esptool: get_major_chip_version)
def revision() i32:
    rev1 = (efuse[3] >> 15) & 1
    rev2 = (efuse[5] >> 20) & 1
    rev3 = (apb[APB_CTRL_DATE] >> 31) & 1
    if rev3 != 0 and rev2 != 0 and rev1 != 0: return 3
    if rev2 != 0 and rev1 != 0: return 2
    if rev1 != 0: return 1
    return 0

def main():
    watchdogs_off()
    timer_start()
    spi_attach(0, 0)
    while True:
        lo = efuse[1]
        hi = efuse[2]
        print("MAC ")
        print_hex2(i32(hi >> 8) & 255)
        put_char(':')
        print_hex2(i32(hi) & 255)
        put_char(':')
        print_hex2(i32(lo >> 24) & 255)
        put_char(':')
        print_hex2(i32(lo >> 16) & 255)
        put_char(':')
        print_hex2(i32(lo >> 8) & 255)
        put_char(':')
        print_hex2(i32(lo) & 255)
        print(", package ")
        print_int(i32((efuse[3] >> 9) & 7) | (i32((efuse[3] >> 2) & 1) << 3))
        print(" (0 ESP32-D0WDQ6, 1 ESP32-D0WD, 2 ESP32-D2WD, 4 ESP32-PICO-D4, 5 PICO-V3, 6 PICO-V3-02, 7 D0WDR2-V3), ")
        print("revision ")
        print_int(revision())
        print("\r\n")
        f = flash_id()
        print("flash ")
        size = i32(f >> 16) & 255
        if size >= 0x14 and size <= 0x1A:
            print_int(1 << (size - 20))
            print(" MB")
        else: print("size unknown")
        print(" (JEDEC id ")
        print_hex2(i32(f) & 255)
        put_char(' ')
        print_hex2(i32(f >> 8) & 255)
        put_char(' ')
        print_hex2(size)
        print(")\r\n")
        wait_ms(5000)
