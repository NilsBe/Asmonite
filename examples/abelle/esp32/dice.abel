# A die with the random number generator of the ESP32: first 600 throws and how often each number came (about 100 each),
# then one throw every second, over UART0 (under the debugger in the tab Serial, else in a terminal on the COM port,
# 115200 baud). F9 in Asmonite runs it in the RAM (gone after a reset); Board > Advanced > Write to Flash and Run writes
# it into the flash at 0x1000 first (in place of the firmware that was there): then the board runs it at every start,
# also without the PC.
#
# RNG_DATA at 0x3FF75144 (ESP32 Technical Reference Manual, chapter "Random Number Generator") gives a new number of
# 32 bits at each read. Its noise comes from the radio (WiFi, Bluetooth) or the SAR ADC; with both off, as here, the
# manual calls the numbers pseudo-random: good for a game, not for keys.
#
# watchdogs_off(): when the boot ROM starts a program from the flash, it switches the watchdogs on. WITHOUT IT A
# BOARD THAT RUNS THE PROGRAM FROM THE FLASH RESETS AFTER A FEW SECONDS (see blink.abel). In the RAM it does no
# harm.
target "esp32"

uart0: u32[32]    at 0x3FF40000     # UART0
timg0: u32[64]    at 0x3FF5F000     # timer group 0
rng:   u32[1]     at 0x3FF75144     # RNG_DATA

UART_FIFO = 0x00 / 4                # takes a byte to send
UART_STATUS = 0x1C / 4              # bits 23..16: the bytes in the FIFO

T0CONFIG = 0x00 / 4
T0LO = 0x04 / 4
T0UPDATE = 0x0C / 4

THROWS = 600

# for watchdogs_off()

timg1:    u32[64]    at 0x3FF60000    # timer group 1
rtc_cntl: u32[64]    at 0x3FF48000    # RTC_CNTL

WDT_KEY = 0x50D83AA1                # unlocks the registers of a watchdog
TIMG_WDTCONFIG0 = 0x48 / 4
TIMG_WDTWPROTECT = 0x64 / 4
RTC_WDTCONFIG0 = 0x8C / 4
RTC_WDTWPROTECT = 0xA4 / 4

digits: char[12]
counts: i32[7]

def watchdogs_off():
    timg0[TIMG_WDTWPROTECT] = WDT_KEY       # unlock
    timg0[TIMG_WDTCONFIG0] = 0              # off
    timg0[TIMG_WDTWPROTECT] = 0             # lock
    timg1[TIMG_WDTWPROTECT] = WDT_KEY
    timg1[TIMG_WDTCONFIG0] = 0
    timg1[TIMG_WDTWPROTECT] = 0
    rtc_cntl[RTC_WDTWPROTECT] = WDT_KEY
    rtc_cntl[RTC_WDTCONFIG0] = 0
    rtc_cntl[RTC_WDTWPROTECT] = 0

# timer 0 on: counts up, each microsecond
def timer_start():
    timg0[T0CONFIG] = u32((1 << 31) | (1 << 30) | (40 << 13))

def micros() u32:
    timg0[T0UPDATE] = 1
    return timg0[T0LO]

def wait_ms(ms):
    start = micros()
    while micros() - start < u32(ms * 1000): pass

def put_char(c):
    while ((uart0[UART_STATUS] >> 16) & 0xFF) >= 120: pass
    uart0[UART_FIFO] = u32(c)

def print(s: pchar):
    n = 0
    while s[n] != 0:
        put_char(s[n])
        n += 1

def print_int(v):
    if v < 0:
        put_char('-')
        v = 0 - v
    p = digits + 11
    p[0] = 0
    while True:
        p -= 1
        p[0] = '0' + i32(u32(v) % 10)
        v = i32(u32(v) / 10)
        if v == 0: break
    print(p)

# 1 .. 6
def throw() i32:
    return i32(rng[0] % 6) + 1

def main():
    watchdogs_off()
    timer_start()
    for i in 0..THROWS: counts[throw()] += 1
    print("dice: ")
    print_int(THROWS)
    print(" throws:")
    for k in 1..7:
        put_char(' ')
        print_int(k)
        put_char('=')
        print_int(counts[k])
    print("\r\n")
    while True:
        print("throw ")
        print_int(throw())
        print("\r\n")
        wait_ms(1000)
