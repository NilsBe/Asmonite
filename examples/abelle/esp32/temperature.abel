# The temperature sensor inside the ESP32: every second its raw value over UART0 (under the debugger in the tab
# Serial, else in a terminal on the COM port, 115200 baud). Put a finger on the chip (the metal can of the module)
# or warm it a little: the value goes up.
# F9 in Asmonite runs it in the RAM (gone after a reset); Debug > Write to Flash and Run writes it into the flash
# at 0x1000 first (in place of the firmware that was there): then the board runs it at every start, also without
# the PC.
#
# The sensor measures the chip itself, not the air around it: the chip warms itself while it works (the more, the
# hotter). It is not calibrated, its offset differs from chip to chip; the newer documents of Espressif leave it out
# for the ESP32 (the ESP32-S3 and ESP32-C3 have a documented one). So it tells changes better than degrees. The old
# ESP-IDF read it as a value around degrees Fahrenheit; "about ... C" below is (raw - 32) * 5 / 9, a guess only.
#
# The registers (ESP-IDF 4.4 components/soc/esp32/include/soc/sens_reg.h; SENS at 0x3FF48800):
#   SENS_SAR_MEAS_WAIT2 +0x0C: bits 19..18 FORCE_XPD_SAR, 3 = the SAR on
#   SENS_SAR_TSENS_CTRL +0x4C: bit 26 DUMP_OUT, 25 POWER_UP_FORCE, 24 POWER_UP, bits 23..16 the clock divider
#   SENS_SAR_SLAVE_ADDR3 +0x44: bits 29..22 TSENS_OUT, the raw value
# A measurement as the old temprature_sens_read() of ESP-IDF did it: the SAR on, the divider 10, the sensor on by
# force, 100 us, then DUMP_OUT, 5 us, read the value.
#
# watchdogs_off(): when the boot ROM starts a program from the flash, it switches the watchdogs on. WITHOUT IT A
# BOARD THAT RUNS THE PROGRAM FROM THE FLASH RESETS AFTER A FEW SECONDS (see blink.abel). In the RAM it does no
# harm.
target "esp32"

uart0: u32[32]    at 0x3FF40000     # UART0
timg0: u32[64]    at 0x3FF5F000     # timer group 0
sens:  u32[64]    at 0x3FF48800     # SENS: the sensors of the RTC part
timg1: u32[64]    at 0x3FF60000     # timer group 1
rtc_cntl: u32[64] at 0x3FF48000     # RTC_CNTL

UART_FIFO = 0x00 / 4                # takes a byte to send
UART_STATUS = 0x1C / 4              # bits 23..16: the bytes in the FIFO

T0CONFIG = 0x00 / 4
T0LO = 0x04 / 4
T0UPDATE = 0x0C / 4

WDT_KEY = 0x50D83AA1                # unlocks the registers of a watchdog
TIMG_WDTCONFIG0 = 0x48 / 4
TIMG_WDTWPROTECT = 0x64 / 4
RTC_WDTCONFIG0 = 0x8C / 4
RTC_WDTWPROTECT = 0xA4 / 4

SAR_MEAS_WAIT2 = 0x0C / 4
SAR_SLAVE_ADDR3 = 0x44 / 4
SAR_TSENS_CTRL = 0x4C / 4
TSENS_DUMP_OUT = 1 << 26
TSENS_POWER_UP_FORCE = 1 << 25
TSENS_POWER_UP = 1 << 24

digits: char[12]

def watchdogs_off():
    timg0[TIMG_WDTWPROTECT] = WDT_KEY       # unlock
    timg0[TIMG_WDTCONFIG0] = 0              # off
    timg0[TIMG_WDTWPROTECT] = 0             # lock
    timg1[TIMG_WDTWPROTECT] = WDT_KEY
    timg1[TIMG_WDTCONFIG0] = 0
    timg1[TIMG_WDTWPROTECT] = 0
    rtc_cntl[RTC_WDTWPROTECT] = WDT_KEY
    rtc_cntl[RTC_WDTCONFIG0] = 0
    rtc_cntl[RTC_WDTWPROTECT] = 0

# timer 0 on: counts up, each microsecond
def timer_start():
    timg0[T0CONFIG] = u32((1 << 31) | (1 << 30) | (40 << 13))

def micros() u32:
    timg0[T0UPDATE] = 1
    return timg0[T0LO]

def wait_us(us):
    start = micros()
    while micros() - start < u32(us): pass

def put_char(c):
    while ((uart0[UART_STATUS] >> 16) & 0xFF) >= 120: pass
    uart0[UART_FIFO] = u32(c)

def print(s: pchar):
    n = 0
    while s[n] != 0:
        put_char(s[n])
        n += 1

def print_int(v):
    if v < 0:
        put_char('-')
        v = 0 - v
    p = digits + 11
    p[0] = 0
    while True:
        p -= 1
        p[0] = '0' + i32(u32(v) % 10)
        v = i32(u32(v) / 10)
        if v == 0: break
    print(p)

# one measurement: the raw value of the sensor (0..255)
def temperature_raw() i32:
    sens[SAR_MEAS_WAIT2] = (sens[SAR_MEAS_WAIT2] & ~u32(3 << 18)) | u32(3 << 18)
    sens[SAR_TSENS_CTRL] = (sens[SAR_TSENS_CTRL] & ~u32(0xFF << 16)) | u32(10 << 16)
    sens[SAR_TSENS_CTRL] = sens[SAR_TSENS_CTRL] & ~u32(TSENS_POWER_UP | TSENS_DUMP_OUT)
    sens[SAR_TSENS_CTRL] = sens[SAR_TSENS_CTRL] | u32(TSENS_POWER_UP_FORCE | TSENS_POWER_UP)
    wait_us(100)
    sens[SAR_TSENS_CTRL] = sens[SAR_TSENS_CTRL] | u32(TSENS_DUMP_OUT)
    wait_us(5)
    return i32((sens[SAR_SLAVE_ADDR3] >> 22) & 0xFF)

def main():
    watchdogs_off()
    timer_start()
    while True:
        raw = temperature_raw()
        print("temperature raw ")
        print_int(raw)
        print(", about ")
        print_int((raw - 32) * 5 / 9)
        print(" C (uncalibrated)\r\n")
        wait_us(1000000)
