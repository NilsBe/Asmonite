# A clock on the ESP32 DevKit: timer 0 of timer group 0 counts microseconds. The LED at GPIO 2 blinks, half a second on
# and off, and every second the program writes how long it runs over UART0 (under the debugger in the tab Serial, else
# in a terminal on the COM port, 115200 baud). F9 in Asmonite runs it in the RAM (gone after a reset);
# Project > Write to Flash and Run writes it into the flash at 0x1000 first (in place of the firmware that was
# there): then the board runs it at every start, also without the PC.
#
# Timer group 0 (ESP32 Technical Reference Manual, chapter "Timer Group"): two timers of 64 bits; T0CONFIG at 0x00
# (bit 31 on, bit 30 counts up, bits 28..13 the divider of the APB clock of 40 MHz), T0LO and T0HI at 0x04 and 0x08,
# T0UPDATE at 0x0C (a write copies the count into T0LO and T0HI). With the divider 40 the timer counts each
# microsecond; its low 32 bits wrap after 71 minutes, the difference of two of them is right all the same.
#
# watchdogs_off(): when the boot ROM starts a program from the flash, it switches the watchdogs on. WITHOUT IT A
# BOARD THAT RUNS THE PROGRAM FROM THE FLASH RESETS AFTER A FEW SECONDS (see blink.abel). In the RAM it does no
# harm.
target "esp32"

gpio:  u32[0x140] at 0x3FF44000     # the GPIO registers
iomux: u32[64]    at 0x3FF49000     # IO_MUX: the function of each pin
uart0: u32[32]    at 0x3FF40000     # UART0
timg0: u32[64]    at 0x3FF5F000     # timer group 0
timg1: u32[64]    at 0x3FF60000     # timer group 1
rtc_cntl: u32[64] at 0x3FF48000     # RTC_CNTL

GPIO_OUT_W1TS = 0x08 / 4            # a 1 sets the pin
GPIO_OUT_W1TC = 0x0C / 4            # a 1 clears it
GPIO_ENABLE_W1TS = 0x24 / 4         # a 1 makes it an output
LED = 2

UART_FIFO = 0x00 / 4                # takes a byte to send
UART_STATUS = 0x1C / 4              # bits 23..16: the bytes in the FIFO

T0CONFIG = 0x00 / 4
T0LO = 0x04 / 4
T0UPDATE = 0x0C / 4

WDT_KEY = 0x50D83AA1                # unlocks the registers of a watchdog
TIMG_WDTCONFIG0 = 0x48 / 4
TIMG_WDTWPROTECT = 0x64 / 4
RTC_WDTCONFIG0 = 0x8C / 4
RTC_WDTWPROTECT = 0xA4 / 4

digits: char[12]

def watchdogs_off():
    timg0[TIMG_WDTWPROTECT] = WDT_KEY       # unlock
    timg0[TIMG_WDTCONFIG0] = 0              # off
    timg0[TIMG_WDTWPROTECT] = 0             # lock
    timg1[TIMG_WDTWPROTECT] = WDT_KEY
    timg1[TIMG_WDTCONFIG0] = 0
    timg1[TIMG_WDTWPROTECT] = 0
    rtc_cntl[RTC_WDTWPROTECT] = WDT_KEY
    rtc_cntl[RTC_WDTCONFIG0] = 0
    rtc_cntl[RTC_WDTWPROTECT] = 0

# timer 0 on: counts up, each microsecond
def timer_start():
    timg0[T0CONFIG] = u32((1 << 31) | (1 << 30) | (40 << 13))

# the microseconds since timer_start (the low 32 bits)
def micros() u32:
    timg0[T0UPDATE] = 1
    return timg0[T0LO]

def wait_ms(ms):
    start = micros()
    while micros() - start < u32(ms * 1000): pass

def put_char(c):
    while ((uart0[UART_STATUS] >> 16) & 0xFF) >= 120: pass
    uart0[UART_FIFO] = u32(c)

def print(s: pchar):
    n = 0
    while s[n] != 0:
        put_char(s[n])
        n += 1

def print_int(v):
    if v < 0:
        put_char('-')
        v = 0 - v
    p = digits + 11
    p[0] = 0
    while True:
        p -= 1
        p[0] = '0' + i32(u32(v) % 10)
        v = i32(u32(v) / 10)
        if v == 0: break
    print(p)

def main():
    watchdogs_off()
    timer_start()
    iomux[0x40 / 4] = 0x2800              # GPIO 2: function GPIO (MCU_SEL 2), drive 2
    gpio[(0x530 + 4 * LED) / 4] = 0x100   # FUNC2_OUT_SEL: a simple output
    gpio[GPIO_ENABLE_W1TS] = 1 << LED
    seconds = 0
    while True:
        gpio[GPIO_OUT_W1TS] = 1 << LED    # on
        wait_ms(500)
        gpio[GPIO_OUT_W1TC] = 1 << LED    # off
        wait_ms(500)
        seconds += 1
        print("uptime ")
        print_int(seconds)
        print(" s, timer ")
        print_int(i32(micros() / 1000))
        print(" ms\r\n")
