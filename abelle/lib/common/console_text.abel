# Text and numbers for the terminal, the same on every board: println, print_int, put_hex, print_byte, print_mac,
# print_ip. console.abel of the board includes this file; they use its put_char and print.
# The names of the parameters and local variables here begin with c_: in aBelle a local name may not be the one of a
# global of the program that includes this file (an assignment would change that global).

con_digits: char[12]

# a text and a line end
def println(c_s: pchar):
    print(c_s)
    print("\r\n")

# a number in decimal
def print_int(c_v):
    if c_v < 0:
        put_char('-')
        c_v = 0 - c_v
    c_p = con_digits + 11
    c_p[0] = 0
    while True:
        c_p -= 1
        c_p[0] = '0' + i32(u32(c_v) % 10)
        c_v = i32(u32(c_v) / 10)
        if c_v == 0: break
    print(c_p)

# a hex digit (0 .. 15)
def put_hex(c_d):
    if c_d < 10: put_char('0' + c_d)
    else: put_char('A' + c_d - 10)

# a byte as two hex digits
def print_byte(c_b):
    put_hex((c_b >> 4) & 15)
    put_hex(c_b & 15)

# the 6 bytes at c_p as a MAC: "02:12:34:56:78:9A"
def print_mac(c_p: pchar):
    for c_i in 0..6:
        if c_i > 0: put_char(':')
        print_byte(c_p[c_i])

# the 4 bytes at c_p as an IPv4 address: "192.168.43.17"
def print_ip(c_p: pchar):
    for c_i in 0..4:
        if c_i > 0: put_char('.')
        print_int(c_p[c_i])
